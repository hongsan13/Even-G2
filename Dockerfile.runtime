# Prebuild with npm ci && npm run server:build before building this image.
FROM node:24-bookworm-slim
ENV NODE_ENV=production PORT=8080
WORKDIR /app
COPY --chown=node:node server-dist ./server-dist
COPY --chown=node:node public/feeds ./public/feeds
COPY --chown=node:node server/admin.html server/admin.js ./server/
COPY --chown=node:node package.json ./package.json
USER node
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s CMD node -e "fetch('http://127.0.0.1:8080/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server-dist/index.js"]
