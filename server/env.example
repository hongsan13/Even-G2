# Supply values in your hosting provider's secret/environment settings, not Git.
PORT=8080
# Administration CORS only. Render adds its own URL automatically.
TRANSIT_ALLOWED_ORIGINS=
# Public station/search responses allow anonymous browser clients, with credentials omitted.
TRANSIT_PUBLIC_API=true
TRANSIT_FEEDS=toei
# Enable restricted providers only after verifying your account/application licence.
ODPT_SERVICE_TERMS_CONFIRMED=false
ODPT_KEY=
ODPT_CHALLENGE_KEY=
TRANSIT_ADMIN_TOKEN=

# Optional non-GTFS official TrainTimetable JSON routes (see docs/ODPT_ACTIVATION.md).
# Total GTFS feeds + JSON routes must be 1–8.
TRANSIT_ODPT_JSON_ROUTES=[]
# Explicit, verified inter-feed connections. IDs are the online catalog IDs.
TRANSIT_TRANSFER_LINKS=[]
